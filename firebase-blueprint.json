{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and default school preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The user UID", "maxLength": 128 },
        "email": { "type": "string", "description": "User email address", "maxLength": 256 },
        "displayName": { "type": "string", "description": "User display name", "maxLength": 150 },
        "photoURL": { "type": "string", "description": "User profile avatar photo", "maxLength": 1000 },
        "namaGuru": { "type": "string", "description": "Default teacher name", "maxLength": 150 },
        "namaSekolah": { "type": "string", "description": "Default school name", "maxLength": 200 },
        "instansi": { "type": "string", "description": "Institution name", "maxLength": 200 },
        "alamat": { "type": "string", "description": "School address", "maxLength": 300 },
        "telp": { "type": "string", "description": "Telephone number", "maxLength": 50 },
        "tahun": { "type": "string", "description": "School year", "maxLength": 50 },
        "semester": { "type": "string", "description": "Semester", "maxLength": 50 },
        "watermarkText": { "type": "string", "description": "Custom watermark text", "maxLength": 100 },
        "watermarkEnabled": { "type": "boolean", "description": "Whether watermark is enabled" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "email"]
    },
    "SavedQuestionSet": {
      "title": "SavedQuestionSet",
      "description": "A saved assessment set generated by a teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID", "maxLength": 128 },
        "userId": { "type": "string", "description": "Owner user ID", "maxLength": 128 },
        "title": { "type": "string", "description": "Title of the question set", "maxLength": 250 },
        "mapel": { "type": "string", "description": "Subject name", "maxLength": 100 },
        "jenjang": { "type": "string", "description": "School level", "maxLength": 50 },
        "kelas": { "type": "string", "description": "Grade level", "maxLength": 50 },
        "topik": { "type": "string", "description": "Topic or material", "maxLength": 300 },
        "curriculum": { "type": "string", "description": "Curriculum type", "maxLength": 50 },
        "soalCount": { "type": "number", "description": "Number of questions" },
        "soalJson": { "type": "string", "description": "JSON serialized questions data", "maxLength": 1000000 },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "title", "mapel", "jenjang", "kelas", "topik", "soalJson"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user profile and settings"
    },
    "/savedQuestions/{questionSetId}": {
      "schema": "SavedQuestionSet",
      "description": "Stores generated questions saved by teachers"
    }
  }
}
